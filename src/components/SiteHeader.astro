---
import { siteMeta } from '../utils/site-meta.mjs';
import { hubStrings, HUB_LOCALES } from '../i18n/hubs.mjs';

const { lang = 'en' } = Astro.props;
const isLocal = HUB_LOCALES.includes(lang);
const labels = isLocal ? (hubStrings as any)[lang].nav : null;
const prefix = isLocal ? `/${lang}` : '';
const nav = isLocal
	? [
			{ label: 'Industry', href: '/industry/' },
			{ label: labels?.applications ?? 'Applications', href: '/applications/' },
			{ label: labels?.vendors ?? 'Vendors', href: '/vendors/' },
			{ label: labels?.protocols ?? 'Protocols', href: `${prefix}/protocols/` },
			{ label: 'Events', href: '/events/' },
			{ label: labels?.devices ?? 'Devices', href: `${prefix}/devices/` },
			{ label: labels?.tools ?? 'Tools', href: `${prefix}/tools/` },
			{ label: 'Data Center', href: '/data-center/' },
		]
	: [
			{ label: 'Industry', href: '/industry/' },
			{ label: 'Applications', href: '/applications/' },
			{ label: 'Vendors', href: '/vendors/' },
			{ label: 'Protocols', href: '/protocols/' },
			{ label: 'Events', href: '/events/' },
			{ label: 'Data Center', href: '/data-center/' },
		];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="brand" href={isLocal ? `${prefix}/` : '/'}>
			<span class="brand__name">{siteMeta.name}</span>
			<span class="brand__tag">INDUSTRY / DATA / TOOLS</span>
		</a>
		<nav class="main-nav" aria-label="Primary">
			{nav.map((item: any) => (
				<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>
	</div>
</header>
