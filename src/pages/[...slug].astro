---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';
import { buildSeo } from '../utils/seo.mjs';
import { hubAlternates } from '../i18n/hubs.mjs';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	const routed = docs.filter(
		(entry) => entry.id !== 'index' && entry.id !== 'vendors/index' && !entry.id.startsWith('product-families'),
	);
	return routed.map((entry) => {
		const slug = entry.id.endsWith('/index') ? entry.id.slice(0, -'/index'.length) : entry.id;
		const section = entry.id.split('/')[0];
		const related = routed
			.filter((other) => other.id !== entry.id && other.id.split('/')[0] === section)
			.sort((a, b) => {
				const ai = a.id.endsWith('/index') ? 0 : 1;
				const bi = b.id.endsWith('/index') ? 0 : 1;
				return ai - bi || a.id.localeCompare(b.id);
			})
			.slice(0, 6)
			.map((other) => ({
				title: other.data.title,
				description: other.data.description,
				href: `/${other.id.endsWith('/index') ? other.id.slice(0, -'/index'.length) : other.id}/`,
			}));
		return { params: { slug }, props: { entry, related } };
	});
}

const { entry, related } = Astro.props;
const alternates = entry.id === 'protocols/index' ? hubAlternates('protocols/') : [];
const { Content, headings } = await render(entry);
const seo = buildSeo(
	{ id: entry.id, entry, lastUpdated: entry.data.lastReviewed },
	Astro.url,
);
---

<Article seo={seo} entry={entry} headings={headings} related={related} alternates={alternates}>
	<Content />
</Article>
