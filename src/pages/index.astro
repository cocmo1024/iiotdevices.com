---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildSeo } from '../utils/seo.mjs';
import { siteMeta } from '../utils/site-meta.mjs';
import { hubAlternates } from '../i18n/hubs.mjs';
import { groupByBrand } from '../utils/vendors.mjs';

const docs = await getCollection('docs');
const routed = docs.filter(
	(entry) => entry.id !== 'index' && entry.id !== 'vendors/index' && !entry.id.startsWith('product-families'),
);
const devices = (await getCollection('devices')).map((d) => d.data);
const brands = groupByBrand(devices);
const bySection = (section: string) =>
	routed
		.filter((e) => e.id.startsWith(`${section}/`))
		.sort((a, b) => (b.data.lastReviewed?.getTime() ?? 0) - (a.data.lastReviewed?.getTime() ?? 0));
const hrefOf = (e: any) => `/${e.id.endsWith('/index') ? e.id.slice(0, -'/index'.length) : e.id}/`;
const dateOf = (e: any) => (e.data.lastReviewed ? e.data.lastReviewed.toISOString().slice(0, 10) : '');
const industry = bySection('industry').filter((e) => e.id !== 'industry/index');
const lead = routed.find((e) => e.id === 'protocols/sps-2026-gateway-lock-in-checks');
const analysis = bySection('comparisons').filter((e) => e.id !== 'comparisons/index').slice(0, 4);
const guides = bySection('applications').filter((e) => e.id !== 'applications/index').slice(0, 4);
const briefs = industry.slice(0, 3);
const seo: any = buildSeo(
	{ id: 'index', entry: { data: { title: siteMeta.name, description: siteMeta.description } } },
	Astro.url,
);
---

<Base seo={seo} alternates={hubAlternates('')}>
	<div class="wrap">
		<section class="lead-story">
			<p class="kicker">Industrial IoT · Connectivity · Brownfield data</p>
			<h1>The industry that connects factories, covered and catalogued.</h1>
			<p class="lede">IIoT Devices is the trade platform for industrial connectivity hardware: industry coverage and analysis from our editorial desk, the vendor and product ecosystem, event reporting — and, underneath it, a device database and engineering tools built only on manufacturer sources.</p>
		</section>
		<section class="lead-grid" aria-label="Top stories">
			<div>
				<p class="kicker" style="font-family:var(--font-mono);font-size:var(--fs-0);letter-spacing:.08em;text-transform:uppercase;color:var(--signal-ink)">Lead story · Events</p>
				{lead && (
					<>
						<h2 style="font-size:var(--fs-5);margin:.5rem 0"><a href={hrefOf(lead)}>{lead.data.title}</a></h2>
						<p style="max-width:62ch">{lead.data.description}</p>
						<p><span class="num">SPS 2026 · 24–26 Nov · Nuremberg</span> — <a href="/events/">All event coverage</a></p>
					</>
				)}
			</div>
			<div>
				<p class="kicker" style="font-family:var(--font-mono);font-size:var(--fs-0);letter-spacing:.08em;text-transform:uppercase;color:var(--signal-ink)">From the industry desk</p>
				<ul class="story-list">
					{briefs.map((e: any) => (
						<li>
							<span class="kicker">Industry · {dateOf(e)}</span>
							<h3><a href={hrefOf(e)}>{e.data.title}</a></h3>
							<p>{e.data.description}</p>
						</li>
					))}
				</ul>
			</div>
		</section>
	</div>
	<div class="band">
		<div class="wrap" style="padding-top:1.5rem;padding-bottom:1.5rem">
			<h2 class="section-title" style="margin-top:0">Vendor ecosystem</h2>
			<p style="max-width:68ch;margin-top:0">Brands appear in the ecosystem index when the desk has checked device records against their own documentation — {brands.length} brands, {devices.length} records so far, growing with every database batch.</p>
			<div class="brand-strip">
				{brands.map((b: any) => (
					<a class="brand-chip" href={`/vendors/${b.slug}/`}>{b.brand} · <b>{b.records.length}</b></a>
				))}
				<a class="brand-chip" href="/vendors/">All vendors →</a>
			</div>
		</div>
	</div>
	<div class="wrap">
		<section class="lead-grid" style="padding:1.5rem 0 0">
			<div>
				<h2 class="section-title" style="margin-top:0">Analysis</h2>
				<ul class="story-list">
					{analysis.map((e: any) => (
						<li><h3><a href={hrefOf(e)}>{e.data.title}</a></h3><p>{e.data.description}</p></li>
					))}
				</ul>
			</div>
			<div>
				<h2 class="section-title" style="margin-top:0">Application guides</h2>
				<ul class="story-list">
					{guides.map((e: any) => (
						<li><h3><a href={hrefOf(e)}>{e.data.title}</a></h3><p>{e.data.description}</p></li>
					))}
				</ul>
			</div>
		</section>
		<section style="padding-bottom:3rem">
			<h2 class="section-title">Data center & tools</h2>
			<p style="max-width:68ch">The platform's working modules: a device database whose every specification carries a manufacturer source and a check date, device-class buying guides, protocol references, and calculators that show their formulas.</p>
			<div class="obj-grid">
				<a class="obj-card" href="/devices/"><h3>Device database</h3><p><span class="num">{devices.length} records</span> · gateways & protocol converters live, more classes in build</p></a>
				<a class="obj-card" href="/tools/"><h3>Engineering tools</h3><p>Modbus polling cycle and bandwidth calculators live, five more in build</p></a>
				<a class="obj-card" href="/device-types/"><h3>Device types</h3><p>How each hardware class works and how to shortlist it</p></a>
				<a class="obj-card" href="/protocols/"><h3>Protocol references</h3><p>OPC UA, Modbus, MQTT and Sparkplug — roles, boundaries, fit</p></a>
			</div>
		</section>
	</div>
</Base>
