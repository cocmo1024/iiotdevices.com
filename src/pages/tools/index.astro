---
import Base from '../../layouts/Base.astro';
import { buildSeo } from '../../utils/seo.mjs';

const tools = [
	{ name: 'Modbus polling cycle calculator', inputs: 'Register count, baud/transaction time, device count', output: 'Realistic poll cycle and scan-class fit' },
	{ name: 'Machine-data bandwidth estimator', inputs: 'Tag count, change rate, payload size, protocol overhead', output: 'Uplink bandwidth and monthly data volume' },
	{ name: 'Edge buffer storage calculator', inputs: 'Tag rate, retention target, record size', output: 'Store-and-forward storage sizing' },
	{ name: 'MQTT throughput & cost estimator', inputs: 'Message rate, payload, broker tier', output: 'Throughput headroom and running cost' },
	{ name: 'LoRaWAN link budget checker', inputs: 'Distance, antenna heights, environment class', output: 'Link margin by spreading factor' },
	{ name: 'Battery life estimator for remote units', inputs: 'Sleep current, wake duty cycle, battery capacity', output: 'Expected service interval' },
	{ name: 'Subnet & address planner', inputs: 'Device count, segmentation plan', output: 'Address blocks and gateway layout' },
];
const seo = buildSeo(
	{
		id: 'tools/index',
		entry: {
			data: {
				title: 'Engineering Tools',
				description: 'Calculators for industrial connectivity work — polling load, bandwidth, edge storage, link budgets — with formulas shown on the page.',
			},
		},
	},
	Astro.url,
);
---

<Base seo={seo}>
	<div class="wrap">
		<nav class="crumbs" aria-label="Breadcrumb"><span><a href="/">Home</a></span><span> / Tools</span></nav>
		<header class="article-head">
			<h1>Engineering tools</h1>
			<p class="lede">Calculators that show their formulas. Each tool ships with its inputs, outputs and assumptions on the same page, so a result can be checked instead of trusted.</p>
			<div class="meta-row"><span>Status <b>First two calculators in build</b></span></div>
		</header>
		<div style="padding:1.5rem 0 3rem">
			<table class="spec-table">
				<thead><tr><th>Tool</th><th>Inputs</th><th>Output</th></tr></thead>
				<tbody>
					{tools.map((t) => (
						<tr><td><b>{t.name}</b></td><td>{t.inputs}</td><td>{t.output}</td></tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</Base>
