---
import Base from '../../layouts/Base.astro';
import { buildSeo } from '../../utils/seo.mjs';

const categories = [
	{ name: 'Industrial gateways', scope: 'Protocol translation and data concentration between PLCs, machines and northbound systems (OPC UA, MQTT).', guide: '/device-types/gateways-edge-computers-and-rtus/' },
	{ name: 'Protocol converters & serial device servers', scope: 'Modbus RTU/TCP conversion, serial-to-Ethernet bridging and legacy interface rescue.', guide: '/protocols/serial-to-ethernet-bridging/' },
	{ name: 'Remote I/O', scope: 'Distributed signal collection over Ethernet fieldbuses and IP networks.', guide: '/applications/when-should-you-use-remote-io-instead-of-a-small-plc/' },
	{ name: 'RTUs', scope: 'Low-power telemetry units for remote sites, utilities and unmanned stations.', guide: '/device-types/gateways-edge-computers-and-rtus/' },
	{ name: 'Industrial routers & cellular', scope: 'WAN connectivity for machines and sites: LTE/5G routers, VPN and remote access.', guide: '/applications/remote-sites-and-telemetry-over-cellular-lorawan-and-satellite-links/' },
	{ name: 'Edge computers', scope: 'On-premise compute for aggregation, buffering, analytics and local applications.', guide: '/comparisons/gateway-vs-edge-computer-for-retrofit-data-projects/' },
];
const seo = buildSeo(
	{
		id: 'devices/index',
		entry: {
			data: {
				title: 'Device Database',
				description: 'Structured database of industrial connectivity hardware — gateways, protocol converters, remote I/O, RTUs, routers and edge computers — with manufacturer-sourced specifications.',
			},
		},
	},
	Astro.url,
);
---

<Base seo={seo}>
	<div class="wrap">
		<nav class="crumbs" aria-label="Breadcrumb"><span><a href="/">Home</a></span><span> / Devices</span></nav>
		<header class="article-head">
			<h1>Device database</h1>
			<p class="lede">One record per device model. Every specification is published only with a manufacturer primary source and a review date; the protocol-mapping export field follows the rule set at SPS 2026 — documented by the manufacturer, or marked undeclared.</p>
			<div class="meta-row"><span>Status <b>Build in progress — gateway records first</b></span></div>
		</header>
		<div style="padding:1.5rem 0 3rem">
			<table class="spec-table">
				<thead><tr><th>Category</th><th>What the database covers</th><th>Selection guide</th></tr></thead>
				<tbody>
					{categories.map((c) => (
						<tr><td><b>{c.name}</b></td><td>{c.scope}</td><td><a href={c.guide}>Open guide</a></td></tr>
					))}
				</tbody>
			</table>
			<p style="color:var(--ink-2);max-width:68ch">Category records are being entered against manufacturer datasheets now. Until a category has sourced records, its selection guide above is the reference — the database does not publish placeholder specification rows.</p>
		</div>
	</div>
</Base>
